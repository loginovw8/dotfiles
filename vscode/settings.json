{
    "workbench.startupEditor": "newUntitledFile",
    "editor.fontFamily": "Monaco",
    "editor.rulers": [
        80
    ],
    "vim.easymotion": true,
    "vim.leader": ",",
    "terminal.integrated.fontSize": 14,
    "editor.suggestSelection": "first",
    "security.workspace.trust.untrustedFiles": "open",
    "settings.cycle": [
        {
            "id": "lineNumbers",
            "overrideWorkspaceSettings": false,
            "values": [
                {
                    "editor.lineNumbers": "off",
                    "editor.folding": false,
                    "editor.glyphMargin": false
                },
                {
                    "editor.lineNumbers": "on",
                    "editor.folding": true,
                    "editor.glyphMargin": true
                }
            ]
        },
        {
            "id": "smoothScrolling",
            "overrideWorkspaceSettings": false,
            "values": [
                {
                    "workbench.list.smoothScrolling": false,
                    "editor.smoothScrolling": false,
                    "editor.cursorSmoothCaretAnimation": "off",
                },
                {
                    "workbench.list.smoothScrolling": true,
                    "editor.smoothScrolling": true,
                    "editor.cursorSmoothCaretAnimation": "on",
                }
            ]
        }
    ],
    "editor.lineNumbers": "on",
    "editor.folding": true,
    "editor.glyphMargin": true,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    // "[php]": {
    //     "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
    // },
    "[scss]": {
        "editor.defaultFormatter": "vscode.css-language-features"
    },
    "emmet.triggerExpansionOnTab": true, // enable tab to expanse emmet tags
    "blade.format.enable": true, // if you would like to enable blade format
    "extensions.autoUpdate": false,
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[css]": {
        "editor.defaultFormatter": "vscode.css-language-features"
    },
    "emmet.includeLanguages": {
        "ejs": "html",
        "blade": "html",
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "js-beautify.indent_size": 4,
    "gitlens.codeLens.enabled": false,
    "gitlens.codeLens.authors.enabled": false,
    "gitlens.currentLine.enabled": false,
    "window.commandCenter": false,
    "workbench.layoutControl.enabled": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "[python]": {
        "editor.formatOnType": true,
        "editor.defaultFormatter": "ms-python.python"
    },
    "workbench.list.smoothScrolling": true,
    "editor.smoothScrolling": true,
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "javascript.updateImportsOnFileMove.enabled": "never",
    "workbench.activityBar.location": "top",
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[vue]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[php]": {
        "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
    },
    "workbench.tree.enableStickyScroll": false,
    "dart.flutterSdkPath": "/Users/macmini/Flutter/flutter",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.stickyScroll.enabled": false,
    "chat.commandCenter.enabled": false,
    "STM32VSCodeExtension.cubeCLT.path": "/opt/ST/STM32CubeCLT_1.18.0",
    "cmake.pinnedCommands": [
        "workbench.action.tasks.configureTaskRunner",
        "workbench.action.tasks.runTask"
    ],
    "STM32VSCodeExtension.projectCreator.executablePath": "/Applications/STMicroelectronics/STM32CubeMX.app/Contents/MacOs/STM32CubeMX",
    "workbench.colorTheme": "Gruvbox Dark Hard",
    "editor.fontSize": 14,
    "workbench.colorCustomizations": {
        "editorGhostText.foreground": "#7A8E96"
    },
    "editor.minimap.enabled": false,
}